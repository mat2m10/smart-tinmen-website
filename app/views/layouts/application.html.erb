<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Smart Tinmen" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#F1F4F3" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0D1615" media="(prefers-color-scheme: dark)">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : 'Product prototyping studio for robotics, sensing and AI. Underwater drones, weeding robots, 3D capture and drone vision that keep working outside the lab.' %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Favicons -->
    <link rel="icon" href="<%= asset_path('favicon.ico') %>" sizes="any">
    <link rel="icon" type="image/png" sizes="16x16" href="<%= asset_path('favicon-16.png') %>">
    <link rel="icon" type="image/png" sizes="32x32" href="<%= asset_path('favicon-32.png') %>">
    <link rel="icon" type="image/png" sizes="48x48" href="<%= asset_path('favicon-48.png') %>">
    <link rel="apple-touch-icon" sizes="180x180" href="<%= asset_path('apple-touch-icon-180.png') %>">
    <link rel="icon" type="image/png" sizes="192x192" href="<%= asset_path('android-192.png') %>">
    <link rel="icon" type="image/png" sizes="512x512" href="<%= asset_path('android-512.png') %>">

    <!-- Open Graph (Slack, LinkedIn, WhatsApp, iMessage, Discord …) -->
    <meta property="og:type"         content="website">
    <meta property="og:url"          content="<%= request.original_url %>">
    <meta property="og:title"        content="<%= content_for?(:title) ? yield(:title) : 'Smart Tinmen' %>">
    <meta property="og:description"  content="<%= content_for?(:description) ? yield(:description) : 'Product prototyping studio for robotics, sensing and AI. Underwater drones, weeding robots, 3D capture and drone vision that keep working outside the lab.' %>">
    <meta property="og:image"        content="<%= asset_url('og-image.png') %>">
    <meta property="og:image:width"  content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type"   content="image/png">
    <meta property="og:image:alt"    content="Smart Tinmen: robots and sensors that keep working outside the lab">
    <!-- Twitter / X -->
    <meta name="twitter:card"  content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for?(:title) ? yield(:title) : 'Smart Tinmen' %>">
    <meta name="twitter:image" content="<%= asset_url('og-image.png') %>">

    <meta http-equiv="x-dns-prefetch-control" content="on">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>