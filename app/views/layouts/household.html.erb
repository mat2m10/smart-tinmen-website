<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Household" : "Household" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#FBF7F1">
    <link rel="manifest" href="<%= household_manifest_path %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Household">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Done, take and drop redirect back to the same page: keep the scroll position. %>
    <%= turbo_refresh_scroll_tag :preserve %>
    <link rel="icon" href="<%= asset_path('favicon.ico') %>" sizes="any">
    <link rel="apple-touch-icon" sizes="180x180" href="<%= asset_path('apple-touch-icon-180.png') %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..24,400,0..1,0&icon_names=add,chevron_left,chevron_right,chat_bubble,check,close,delete,edit,expand_less,expand_more,logout,mic,photo_camera,send,stop,undo&display=block" rel="stylesheet">
    <%= stylesheet_link_tag "household", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="hh"<% if current_user %> data-controller="badge" data-badge-count-value="<%= current_user.badge_count %>"<% end %>>
    <% if current_user %>
      <header class="hh-appbar">
        <%= link_to "Household", household_root_path, class: "hh-brand" %>
        <nav class="hh-nav" aria-label="Sections">
          <%= link_to "Chores", household_root_path, aria: { current: (controller_name == "chores" ? "page" : nil) } %>
          <%= link_to "Agenda", household_agenda_path, aria: { current: (controller_name == "agenda" ? "page" : nil) } %>
          <%= link_to "Notes", household_notes_path, aria: { current: (controller_name == "notes" ? "page" : nil) } %>
          <%= link_to "Done", household_completions_path, aria: { current: (controller_name == "completions" ? "page" : nil) } %>
        </nav>
        <div class="hh-me">
          <%= link_to household_profile_path, class: "hh-me-link", aria: { label: "Your profile", current: (controller_name == "profiles" ? "page" : nil) } do %><%= avatar(current_user, title: "Your profile") %><% end %>
          <%= button_to household_logout_path, method: :delete, class: "hh-icon-btn", title: "Sign out", aria: { label: "Sign out" } do %><span class="ms" aria-hidden="true">logout</span><% end %>
        </div>
      </header>
    <% end %>
    <main class="hh-page">
      <% flash.each do |type, message| %>
        <% next if type == "undo" %>
        <div class="hh-flash hh-flash--<%= type %>" role="status">
          <span><%= message %></span>
          <% if type == "notice" && flash[:undo] %>
            <%= button_to "Undo", household_completion_path(flash[:undo], return_to: "board"), method: :delete, class: "hh-btn hh-btn--text" %>
          <% end %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
