<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Household" : "Household" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#F8FAFD" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#131314" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="<%= asset_path('favicon.ico') %>" sizes="any">
    <link rel="apple-touch-icon" sizes="180x180" href="<%= asset_path('apple-touch-icon-180.png') %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..24,400,0..1,0&icon_names=add,chat_bubble,check,close,delete,expand_less,expand_more,logout,mic,photo_camera,send,stop&display=block" rel="stylesheet">
    <%= stylesheet_link_tag "household", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="hh">
    <% if current_user %>
      <header class="hh-appbar">
        <%= link_to "Household", household_root_path, class: "hh-brand" %>
        <nav class="hh-nav" aria-label="Sections">
          <%= link_to "Chores", household_root_path, aria: { current: (controller_name == "chores" ? "page" : nil) } %>
          <%= link_to "Notes", household_notes_path, aria: { current: (controller_name == "notes" ? "page" : nil) } %>
        </nav>
        <div class="hh-me">
          <span class="hh-avatar" title="<%= current_user.display_name %>"><%= current_user.initial %></span>
          <%= button_to household_logout_path, method: :delete, class: "hh-icon-btn", title: "Sign out", aria: { label: "Sign out" } do %><span class="ms" aria-hidden="true">logout</span><% end %>
        </div>
      </header>
    <% end %>
    <main class="hh-page">
      <% flash.each do |type, message| %>
        <p class="hh-flash hh-flash--<%= type %>" role="status"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
