<%# ============================================================
    FILE: app/views/pages/home.html.erb
    PURPOSE: Main entry point — renders all partials in order.
    Styles live in: app/assets/stylesheets/home.css
    Fonts are loaded in: app/views/layouts/application.html.erb
    JS (founder modal) lives in: app/javascript/controllers/home.js
    ============================================================ %>

<main class="st-main">

  <div class="st-container">
    <%= render 'pages/header' %>
    <%= render 'pages/hero' %>
    <hr class="st-divider">
    <%= render 'pages/services' %>
    <%= render 'pages/work' %>
    <%= render 'pages/process' %>
    <%= render 'pages/founders' %>
    <%= render 'pages/founder_modal' %>
    <%= render 'pages/contact' %>
    <%= render 'pages/footer' %>
  </div>

</main>