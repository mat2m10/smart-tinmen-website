<%# ============================================================
    FILE: app/views/home/_founders.html.erb
    PURPOSE: Founders section — clickable founder cards.
    Each card calls openFounder('id') defined in home.js.
    Image paths are in data-img so home.js can read them without ERB.
    ============================================================ %>

<section id="founders" class="st-section">
  <h2>Founders</h2>
  <div class="st-grid">

    <%# ── Harold ── %>
    <div class="st-founder-card" data-founder="harold" data-img="<%= image_path 'HL_picture.jpg' %>">
      <%= image_tag "HL_picture.jpg", alt: "Harold Loop — CEO" %>
      <div>
        <div class="st-founder-name">Harold Loop</div>
        <div class="st-founder-role">CEO</div>
        <div class="st-founder-bio">Project leadership, stakeholder alignment, and on-site delivery for complex technical environments.</div>
        <div class="st-founder-hint">Click for full profile</div>
      </div>
    </div>

    <%# ── Matthieu ── %>
    <div class="st-founder-card" data-founder="matthieu" data-img="<%= image_path 'MDH_picture.jpg' %>">
      <%= image_tag "MDH_picture.jpg", alt: "Matthieu de Hemptinne — CTO" %>
      <div>
        <div class="st-founder-name">Matthieu de Hemptinne</div>
        <div class="st-founder-role">CTO</div>
        <div class="st-founder-bio">Robotics, embedded systems, and deployment-focused software—built to work in constrained real-world settings.</div>
        <div class="st-founder-hint">Click for full profile</div>
      </div>
    </div>

  </div>
</section>
