<%# ============================================================
    FILE: app/views/pages/_contact.html.erb
    PURPOSE: Contact — what to send us, and the email address.
    The copy button uses app/javascript/controllers/clipboard_controller.js.
    ============================================================ %>

<section id="contact" class="st-block">
  <div class="st-wrap st-contact">
    <div>
      <h2 class="st-h2">Tell us what you are building</h2>
      <ol>
        <li>What you want to build or test</li>
        <li>Your constraints: budget, timeline, environment</li>
        <li>What success looks like</li>
      </ol>
    </div>
    <div class="st-plate st-mailbox" data-controller="clipboard"><i class="st-rv"></i>
      <div class="st-eyebrow">Email</div>
      <a class="st-addr" href="mailto:info@smarttinmen.com" data-clipboard-target="source">info@smarttinmen.com</a>
      <button type="button" data-action="clipboard#copy" data-clipboard-target="button">Copy address</button>
      <small>We reply within 1–2 business days with a scoped plan and an estimate.</small>
    </div>
  </div>
</section>
