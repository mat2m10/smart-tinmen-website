<%= form_with model: [ :household, chore ], class: "hh-form" do |f| %>
  <% if chore.errors.any? %>
    <div class="hh-errors" role="alert">
      <% chore.errors.full_messages.each do |message| %><p><%= message %></p><% end %>
    </div>
  <% end %>

  <%= f.label :title, "What needs doing" %>
  <%= f.text_field :title, required: true, autofocus: chore.new_record? %>

  <div class="hh-row">
    <div>
      <%= f.label :area %>
      <%= f.text_field :area, list: "hh-areas", required: true, maxlength: 40 %>
      <datalist id="hh-areas"><% Chore.visible_to(current_user).area_options.each do |area| %><option value="<%= area %>"><% end %></datalist>
    </div>
    <div>
      <%= f.label :room, "Room (optional)" %>
      <%= f.text_field :room, list: "hh-rooms", maxlength: 40 %>
      <datalist id="hh-rooms"><% Chore.visible_to(current_user).room_options.each do |room| %><option value="<%= room %>"><% end %></datalist>
    </div>
  </div>

  <div class="hh-row">
    <div>
      <%= f.label :due_on, "Next due" %>
      <%= f.date_field :due_on, required: true %>
    </div>
    <div>
      <%= f.label :due_time, "Time (optional, for appointments)" %>
      <%= f.time_field :due_time, value: chore.due_time %>
    </div>
  </div>

  <%= f.label :assignee_id, "Owner" %>
  <%= f.select :assignee_id, User.order(:name, :email).map { |u| [ u.display_name, u.id ] }, include_blank: "Up for grabs" %>
  <label class="hh-check"><%= f.check_box :personal %> Personal: only for me, the others don't see it</label>

  <div class="hh-row">
    <div>
      <%= f.label :repeat_unit, "Repeats" %>
      <%= f.select :repeat_unit, [ [ "Once", "none" ], [ "Daily", "day" ], [ "Weekdays (Mon–Fri)", "weekday" ], [ "Weekly", "week" ], [ "Monthly", "month" ], [ "Yearly", "year" ] ] %>
    </div>
    <div>
      <%= f.label :repeat_every, "Every how many" %>
      <%= f.number_field :repeat_every, min: 1, max: 365 %>
    </div>
  </div>

  <fieldset class="hh-effort">
    <legend>Effort</legend>
    <% Chore::EFFORTS.each do |value, label| %>
      <label><%= f.radio_button :effort, value %> <%= label %></label>
    <% end %>
  </fieldset>

  <label class="hh-check"><%= f.check_box :planning %> Planning task (noticing, booking, organising)</label>
  <label class="hh-check"><%= f.check_box :fixed_schedule %> Keep a fixed date (e.g. rent on the 25th), not counted from when it was done</label>

  <%= f.label :notes, "Notes (how, where, what counts as done)" %>
  <%= f.text_area :notes, rows: 4 %>

  <div class="hh-form-actions">
    <%= f.submit chore.new_record? ? "Add" : "Save", class: "hh-btn hh-btn--filled" %>
    <%= link_to "Cancel", household_root_path, class: "hh-btn hh-btn--text" %>
  </div>
<% end %>
