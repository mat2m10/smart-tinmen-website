<section class="hh-front-notes" aria-label="Notes">
  <%= render "household/notes/composer", note: @note, placeholder: "Write a note, add a photo or a voice note…", return_to: "board" %>
  <% if @latest_notes.any? %>
    <ul class="hh-feed"><%= render partial: "household/notes/note", collection: @latest_notes, locals: { show_chore: true } %></ul>
    <%= link_to "All notes", household_notes_path, class: "hh-btn hh-btn--text hh-more" %>
  <% end %>
</section>

<div class="hh-card hh-push" data-controller="push" data-push-key-value="<%= ENV["VAPID_PUBLIC_KEY"] %>" hidden>
  <p data-push-target="message">Get reminders and new notes on this phone.</p>
  <button type="button" class="hh-btn hh-btn--tonal" data-push-target="button" data-action="push#toggle">Turn on notifications</button>
</div>

<nav class="hh-chips" aria-label="Filter">
  <% { "all" => "Everything", "mine" => "Mine", "free" => "Up for grabs" }.each do |key, label| %>
    <%= link_to household_root_path(show: (key unless key == "all")), class: "hh-chip", aria: { current: (@filter == key ? "page" : nil) } do %>
      <% if @filter == key %><span class="ms" aria-hidden="true">check</span><% end %><%= label %>
    <% end %>
  <% end %>
</nav>

<% if @buckets.empty? %>
  <p class="hh-empty">Nothing here. Enjoy it.</p>
<% end %>

<% Household::ChoresController::BUCKETS.each do |key, label| %>
  <% chores = @buckets[key] %>
  <% next if chores.blank? %>
  <% if key == :later %>
    <details class="hh-group">
      <summary><h2><%= label %> <span class="hh-count"><%= chores.size %></span></h2></summary>
      <ul class="hh-list"><%= render partial: "chore", collection: chores %></ul>
    </details>
  <% else %>
    <section class="hh-group hh-group--<%= key %>">
      <h2><%= label %> <span class="hh-count"><%= chores.size %></span></h2>
      <ul class="hh-list"><%= render partial: "chore", collection: chores %></ul>
    </section>
  <% end %>
<% end %>

<section class="hh-card hh-balance">
  <h2>Last 30 days</h2>
  <% max = [ @effort.values.max.to_i, 1 ].max %>
  <% @users.each do |user| %>
    <div class="hh-bar">
      <span class="hh-bar-name"><%= user.display_name %></span>
      <span class="hh-bar-track"><span class="hh-bar-fill" style="width: <%= (100 * @effort[user.id].to_i / max).round %>%"></span></span>
      <span class="hh-bar-value"><%= pluralize(@effort[user.id].to_i, "point") %> · <%= @planning[user.id].to_i %> planning</span>
    </div>
  <% end %>
  <p class="hh-hint">Points: quick 1, medium 2, big 3. Planning = noticing and organising, the invisible part.</p>

  <% if @recently_done.any? %>
    <h3>Recently done</h3>
    <ul class="hh-done">
      <% @recently_done.each do |completion| %>
        <li><strong><%= completion.user&.display_name || "Someone" %></strong> · <%= completion.chore.title %> · <%= completion.completed_on.strftime("%-d %b") %></li>
      <% end %>
    </ul>
  <% end %>
</section>

<%= link_to new_household_chore_path, class: "hh-fab", aria: { label: "Add a task" } do %><span class="ms" aria-hidden="true">add</span><span>Add</span><% end %>
