<%= form_with model: note, url: household_notes_path, class: "hh-card hh-composer", multipart: true, data: { controller: "photo-picker recorder", action: "submit->recorder#submit" } do |f| %>
  <%= f.hidden_field :chore_id %>
  <% if local_assigns[:return_to] %><%= hidden_field_tag :return_to, return_to %><% end %>
  <%= f.label :body, placeholder, class: "hh-visually-hidden" %>
  <%= f.text_area :body, rows: 3, placeholder: placeholder, maxlength: 5000, data: { action: "paste->photo-picker#paste" } %>

  <div class="hh-previews" data-photo-picker-target="previews"></div>
  <div class="hh-recording" data-recorder-target="panel" hidden>
    <span class="hh-rec-dot" data-recorder-target="dot"></span>
    <span data-recorder-target="status">Recording…</span>
    <audio controls data-recorder-target="preview" hidden></audio>
    <button type="button" class="hh-icon-btn" data-action="recorder#discard" aria-label="Remove the voice note"><span class="ms" aria-hidden="true">close</span></button>
  </div>

  <div class="hh-composer-actions">
    <label class="hh-btn hh-btn--text">
      <span class="ms" aria-hidden="true">photo_camera</span>Photo
      <%= f.file_field :photos, multiple: true, accept: "image/*", class: "hh-visually-hidden", data: { photo_picker_target: "input", action: "photo-picker#pick" } %>
    </label>
    <button type="button" class="hh-btn hh-btn--text" data-recorder-target="start" data-action="recorder#start" hidden><span class="ms" aria-hidden="true">mic</span>Voice</button>
    <button type="button" class="hh-btn hh-btn--tonal" data-recorder-target="stop" data-action="recorder#stop" hidden><span class="ms" aria-hidden="true">stop</span>Stop</button>
    <label class="hh-btn hh-btn--text" data-recorder-target="fallback">
      <span class="ms" aria-hidden="true">mic</span>Audio file
      <%= f.file_field :voice, accept: "audio/*", class: "hh-visually-hidden", data: { recorder_target: "input" } %>
    </label>
    <button type="submit" class="hh-btn hh-btn--filled hh-send"><span class="ms" aria-hidden="true">send</span>Post</button>
  </div>
<% end %>
