<li class="hh-item<%= " hh-item--ticked" if item.ticked? %>">
  <%= button_to household_list_item_path(list, item), method: :patch, class: "hh-item-tick", aria: { label: item.ticked? ? "Put #{item.body} back on the list" : "Tick off #{item.body}", pressed: item.ticked?.to_s } do %>
    <span class="ms" aria-hidden="true"><%= item.ticked? ? "check_box" : "check_box_outline_blank" %></span>
    <span class="hh-item-body"><%= item.body %></span>
  <% end %>
  <% if item.added_by %><span class="hh-item-by"><%= avatar(item.added_by, small: true, title: "Added by #{item.added_by.display_name}") %></span><% end %>
  <%= button_to household_list_item_path(list, item), method: :delete, class: "hh-icon-btn", aria: { label: "Remove #{item.body}" } do %><span class="ms" aria-hidden="true">close</span><% end %>
</li>
