<% content_for :title, "Edit #{@list.name_was}" %>
<h1 class="hh-title">Edit list</h1>

<%= form_with model: @list, url: tabletop_list_path(@list), scope: :army_list, class: "hh-card hh-form" do |f| %>
  <% if @list.errors.any? %>
    <div class="hh-errors"><%= @list.errors.full_messages.to_sentence %></div>
  <% end %>

  <%= f.label :name, "Name" %>
  <%= f.text_field :name, required: true, maxlength: 80 %>

  <% if @list.legion? %>
    <%= f.label :points_limit, "Points limit" %>
    <%= f.number_field :points_limit, min: 1, step: 1, inputmode: "numeric" %>
  <% end %>

  <%= f.label :notes, "Notes" %>
  <%= f.text_area :notes, rows: 4, placeholder: "Plan, deployment, things to remember" %>

  <div class="hh-form-actions">
    <%= f.submit "Save", class: "hh-btn hh-btn--filled" %>
    <%= link_to "Cancel", tabletop_list_path(@list), class: "hh-btn" %>
  </div>
<% end %>

<%= button_to tabletop_list_path(@list), method: :delete, class: "hh-btn hh-btn--danger", form: { data: { turbo_confirm: "Delete this list?" } } do %><span class="ms" aria-hidden="true">delete</span>Delete list<% end %>
